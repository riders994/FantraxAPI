# Copy this file to .env and fill in real values. .env is gitignored, so it's
# safe to put credentials and personal league IDs there.

# --- tests/test_live_api.py -------------------------------------------------
# Requires a logged-in session against a real league. LOCAL=True reuses a cached
# fantraxloggedin.cookie instead of driving a headless Chrome login each run.
FANTRAX_USERNAME=
FANTRAX_PASSWORD=
LOCAL=False
LEAGUE_ID=

# --- tests/test_live_matchup_types.py ---------------------------------------
# League IDs covering each (sport, matchup_type) combination a Fantrax league
# can be created with. No login required -- any public league ID works. Leave
# a combination blank to skip it until a real league for it is found.
#
# Format: LEAGUE_ID_<SPORT>_<MATCHUP_TYPE>
LEAGUE_ID_NBA_H2HROTISSERIE2=
LEAGUE_ID_NBA_H2HPOINTSBASED3=
LEAGUE_ID_NHL_H2HROTISSERIE2=
LEAGUE_ID_NHL_H2HPOINTSBASED3=
